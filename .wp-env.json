{
  "core": "WordPress/WordPress#6.7",
  "plugins": ["./plugin"],
  "mappings": {
    "wp-content/plugins/plugin/tests": "./tests",
    "wp-content/plugins/plugin/phpunit.xml.dist": "./phpunit.xml.dist",
    "wp-content/plugins/plugin/vendor": "./vendor"
  },
  "themes": [
    "WordPress/twentytwentyfour"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "development",
    "WP_AUTO_LOGIN": true
  },
  "port": 8888,
  "env": {
    "development": {
      "port": 8889
    },
    "tests": {
      "port": 8890
    }
  }
}
